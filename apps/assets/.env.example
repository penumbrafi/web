# Postgres connection string for the pindexer database (read-only role is enough).
# Same variable veil uses. Optional TLS CA: PENUMBRA_INDEXER_CA_CERT (PEM or path).
PENUMBRA_INDEXER_ENDPOINT=postgresql://user:password@host:5432/pindexer

# Port the standalone server binds to. Production uses 3004 (3003 is taken
# by the airdrop app on the same container).
PORT=3004
