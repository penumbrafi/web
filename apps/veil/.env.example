# Public origin the app is served from. Canonical URLs and OpenGraph image
# URLs are built from it, so it must match the vhost exactly (no trailing
# slash). Production value: https://penumbra.fi
BASE_URL=https://penumbra.fi
PENUMBRA_GRPC_ENDPOINT=
PENUMBRA_INDEXER_ENDPOINT=
PENUMBRA_INDEXER_CA_CERT=
PENUMBRA_CHAIN_ID=
PENUMBRA_CUILOA_URL=

# GraphQL endpoint backing the /inspect/* chain explorer surface.
# Hostname only (no scheme); the client builds https:// + wss:// from this.
NEXT_PUBLIC_GRAPHQL_HOST=

# CometBFT RPC WebSocket — used directly from the browser to subscribe to
# new block events for the explorer block panel. Bypassing the indexer
# here means live updates can't be stalled by an indexer-side WS proxy
# or pg notification hiccup. Full ws:// or wss:// URL including path.
NEXT_PUBLIC_COMETBFT_WS_URL=wss://penumbra.rotko.net/websocket
