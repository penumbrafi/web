# Production env for veil (https://penumbra.fi, alias dex.rotko.net).
# Build-time variables used by Next.js when running `pnpm build`.

# GraphQL endpoint backing the /inspect/* explorer surface.
# Pindexer-fed Hasura/GraphQL gateway.
NEXT_PUBLIC_GRAPHQL_HOST=api.explorer.rotko.net

# In CI these come from the repository variables of the same name
# (see deploy/README.md); this file is the local-build fallback.
