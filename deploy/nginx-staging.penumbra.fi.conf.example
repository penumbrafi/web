# /etc/nginx/sites-available/staging.penumbra.fi
#
# Companion vhost to the prod penumbra.fi one. Proxies to the
# `veil_staging` upstream defined by /etc/nginx/veil-upstream.conf,
# which veil-swap keeps pointed at the currently-STANDBY colour. So
# whatever the deploy job just shipped without promoting is always
# visible at https://staging.penumbra.fi.
#
# Gate this vhost behind whatever access control your team is happy
# with. Cloudflare Access on the zone is the simplest — that way an
# unshipped build is never anonymously reachable. If you prefer HTTP
# basic auth, drop an `auth_basic` block in the `location /` below and
# hand out /etc/nginx/.htpasswd via your usual secret path.

server {
    listen 80;
    listen [::]:80;
    server_name staging.penumbra.fi;
    location /.well-known/acme-challenge/ { root /var/www/letsencrypt; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name staging.penumbra.fi;

    ssl_certificate     /etc/letsencrypt/live/staging.penumbra.fi/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/staging.penumbra.fi/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    # Staging is never indexed.
    add_header X-Robots-Tag "noindex, nofollow" always;

    proxy_http_version 1.1;
    proxy_set_header Upgrade         $http_upgrade;
    proxy_set_header Connection      "upgrade";
    proxy_set_header Host            $host;
    proxy_set_header X-Real-IP       $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto https;

    proxy_intercept_errors on;
    error_page 502 504 = @staging_down;

    location / {
        proxy_pass http://veil_staging;
        proxy_connect_timeout 3s;
        proxy_read_timeout    30s;
    }

    location @staging_down {
        add_header X-Robots-Tag "noindex, nofollow" always;
        add_header Content-Type "text/plain; charset=utf-8" always;
        return 502 "Staging build is not answering. The next deploy will reset this.\n";
    }
}
