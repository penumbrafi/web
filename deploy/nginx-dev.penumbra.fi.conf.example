# /etc/nginx/sites-available/dev.penumbra.fi
#
# WIP-branch vhost. Serves whatever the last `gh workflow run
# deploy-dev.yml` deployed to the `dev` slot on the workload container
# (CT1199) — a fixed port (3010), NOT the blue/green upstream used by
# penumbra.fi. Single-slot: no swap, no promote, no "staging" companion.
#
# GATE THIS behind Cloudflare Access at the zone level (or a broader
# `*.dev.penumbra.fi` policy). A WIP branch that anyone can push is not
# something to leave anonymously reachable — the cloudflare-allowlist
# include below refuses non-CF origins so a `curl --resolve
# dev.penumbra.fi:443:<origin-ip>` bypass round can't slip past Access.
#
# TLS: either extend the wildcard `*.dev.penumbra.fi` cert planned for
# per-PR previews (see the previews section of deploy/README.md) or
# issue a plain `dev.penumbra.fi` cert via certbot. Both work; the
# wildcard is nicer because previews and this vhost then share a cert.
#
# `X-Robots-Tag: noindex, nofollow` — a WIP URL should never be indexed.

# Direct proxy to the workload container's dev port. No `upstream {}`
# indirection: the port is fixed, no swap ever happens, and the
# machine-name of the workload container is not secret but the ADDRESS
# is — write it into a root-owned include so it isn't committed. See
# host setup notes in deploy/README.md.
#
# /etc/nginx/veil-dev-backend.conf (root:root 0644):
#     set $veil_dev_upstream <WORKLOAD_HOST_INTERNAL_IP>:3010;

server {
    listen 80;
    listen [::]:80;
    server_name dev.penumbra.fi;
    location /.well-known/acme-challenge/ { root /var/www/letsencrypt; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name dev.penumbra.fi;

    # Wildcard cert if per-PR previews are set up; the specific-name
    # cert works just as well. Whichever you have — keep this pointing
    # at the file that exists.
    ssl_certificate     /etc/letsencrypt/live/dev.penumbra.fi/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/dev.penumbra.fi/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    add_header X-Robots-Tag "noindex, nofollow" always;

    # Cloudflare-only origin gate — same include prod / staging use.
    include /etc/nginx/cloudflare-allowlist.conf;
    if ($cf_gated_allowed = "0") { return 403; }

    include /etc/nginx/veil-dev-backend.conf;

    proxy_http_version 1.1;
    proxy_set_header Upgrade         $http_upgrade;
    proxy_set_header Connection      "upgrade";
    proxy_set_header Host            $host;
    proxy_set_header X-Real-IP       $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto https;

    proxy_intercept_errors on;
    error_page 502 504 = @dev_down;

    location / {
        proxy_pass http://$veil_dev_upstream;
        proxy_connect_timeout 3s;
        proxy_read_timeout    30s;
    }

    location @dev_down {
        add_header X-Robots-Tag "noindex, nofollow" always;
        add_header Content-Type "text/plain; charset=utf-8" always;
        return 502 "Dev slot is not answering. Run `gh workflow run deploy-dev.yml` from the branch you want to see.\n";
    }
}
