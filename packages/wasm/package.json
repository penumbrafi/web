{
  "name": "@penumbrafi/wasm",
  "version": "56.0.0",
  "license": "(MIT OR Apache-2.0)",
  "description": "Penumbra WASM bindings (serial bundler build + parallel rayon build) with async API. Published from penumbrafi/web.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/penumbrafi/web.git",
    "directory": "packages/wasm"
  },
  "type": "module",
  "engine": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc --build --verbose",
    "clean": "rm -rfv dist *.tsbuildinfo wasm wasm-parallel package penumbra-zone-*.tgz",
    "clean:rust": "cargo clean --manifest-path ./crate/Cargo.toml",
    "compile": "cd crate && wasm-pack build --no-pack --target bundler --out-name index --out-dir ../wasm",
    "compile:all": "pnpm compile && pnpm compile:parallel",
    "compile:bundler": "cd crate && wasm-pack build --no-pack --target bundler --out-name index --out-dir ../wasm",
    "compile:parallel": "bash ./crate/scripts/build-wasm-parallel.sh",
    "dev:compile": "cargo watch -C ./crate --postpone -- $npm_execpath run compile",
    "dev:pack": "tsc-watch --onSuccess \"$npm_execpath pack\"",
    "format:rust": "cd crate && cargo fmt --all",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "lint:rust": "cd crate && cargo fmt --all -- --check && cargo clippy -- -D warnings && cargo clippy --tests -- -D warnings",
    "lint:strict": "tsc --noEmit && eslint src --max-warnings 0",
    "postcompile": "mkdir -p ./wasm && touch ./wasm/.npmignore",
    "test": "vitest run",
    "test:cargo": "cd crate && cargo test --release",
    "test:wasm": "cd crate && wasm-pack test --headless --firefox -- --target wasm32-unknown-unknown --release"
  },
  "files": [
    "wasm",
    "wasm-parallel",
    "dist"
  ],
  "exports": {
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./wasm-parallel": {
      "types": "./wasm-parallel/index.d.ts",
      "default": "./wasm-parallel/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@bufbuild/protobuf": "^1.10.0",
    "@penumbra-zone/bech32m": "workspace:*",
    "@penumbra-zone/keys": "workspace:*",
    "@penumbra-zone/protobuf": "workspace:*",
    "@penumbrafi/types": "workspace:*",
    "fake-indexeddb": "^6.0.0"
  },
  "peerDependencies": {
    "@bufbuild/protobuf": "^1.10.0",
    "@penumbra-zone/bech32m": ">=18.0.0",
    "@penumbra-zone/protobuf": ">=11.0.0",
    "@penumbrafi/types": "workspace:^"
  }
}
