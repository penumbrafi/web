+    /// the modulus as 32-bit limbs, split once per field at compile time
+    struct Modulus32<T, const N: usize>(core::marker::PhantomData<T>);
+    impl<T: MontConfig<N>, const N: usize> Modulus32<T, N> {
+        const P: [u32; 12] = {
+            let mut o = [0u32; 12];
+            let mut i = 0;
+            while i < N && i < 6 {
+                o[2 * i] = T::MODULUS.0[i] as u32;
+                o[2 * i + 1] = (T::MODULUS.0[i] >> 32) as u32;
+                i += 1;
+            }
+            o
+        };
+    }
+
+    /// `a^2 * R^-1 mod p`, or None for the u64 path
+    #[inline(always)]
+    pub(super) fn square<T: MontConfig<N>, const N: usize>(
+        a: &Fp<MontBackend<T, N>, N>,
+    ) -> Option<[u64; N]> {
+        let inv = T::INV as u32;
+        let p = &Modulus32::<T, N>::P;
+        #[allow(unsafe_code)]
+        unsafe {
+            match N {
+                6 => {
+                    let mut t = [0u32; 25];
+                    sqr12(&core::mem::transmute_copy(&(a.0).0), &mut t);
+                    Some(core::mem::transmute_copy(&redc12(&mut t, p, inv)))
+                }
+                4 => {
+                    let p8: &[u32; 8] = &*(p.as_ptr() as *const [u32; 8]);
+                    let mut t = [0u32; 17];
+                    sqr8(&core::mem::transmute_copy(&(a.0).0), &mut t);
+                    Some(core::mem::transmute_copy(&redc8(&mut t, p8, inv)))
+                }
+                _ => None,
+            }
+        }
+    }
+
+    /// `(a0*b0 + a1*b1) * R^-1 mod p` with one reduction, or None
+    #[inline(always)]
+    pub(super) fn sum_of_two<T: MontConfig<N>, const N: usize>(
+        a: [&Fp<MontBackend<T, N>, N>; 2],
+        b: [&Fp<MontBackend<T, N>, N>; 2],
+    ) -> Option<[u64; N]> {
+        let inv = T::INV as u32;
+        let p = &Modulus32::<T, N>::P;
+        #[allow(unsafe_code)]
+        unsafe {
+            match N {
+                6 => {
+                    let (mut t, mut u) = ([0u32; 25], [0u32; 25]);
+                    wide12(&core::mem::transmute_copy(&(a[0].0).0), &core::mem::transmute_copy(&(b[0].0).0), &mut t);
+                    wide12(&core::mem::transmute_copy(&(a[1].0).0), &core::mem::transmute_copy(&(b[1].0).0), &mut u);
+                    add_into(&mut t, &u);
+                    Some(core::mem::transmute_copy(&redc12(&mut t, p, inv)))
+                }
+                4 => {
+                    let p8: &[u32; 8] = &*(p.as_ptr() as *const [u32; 8]);
+                    let (mut t, mut u) = ([0u32; 17], [0u32; 17]);
+                    wide8(&core::mem::transmute_copy(&(a[0].0).0), &core::mem::transmute_copy(&(b[0].0).0), &mut t);
+                    wide8(&core::mem::transmute_copy(&(a[1].0).0), &core::mem::transmute_copy(&(b[1].0).0), &mut u);
+                    add_into(&mut t, &u);
+                    Some(core::mem::transmute_copy(&redc8(&mut t, p8, inv)))
+                }
+                _ => None,
+            }
+        }
+    }
+
+    /// `a * b * R^-1 mod p` for 4- and 6-limb fields; None means "use the u64 path".
+    #[inline(always)]
+    pub(super) fn mul<T: MontConfig<N>, const N: usize>(
+        a: &Fp<MontBackend<T, N>, N>,
+        b: &Fp<MontBackend<T, N>, N>,
+    ) -> Option<[u64; N]> {
+        // -p^-1 mod 2^32 is the low half of -p^-1 mod 2^64
+        let inv = T::INV as u32;
+        let p = &Modulus32::<T, N>::P;
+        // wasm32 is little-endian: [u64; N] and [u32; 2N] share a layout
+        #[allow(unsafe_code)]
+        unsafe {
+            match N {
+                6 => {
+                    let r = cios12(
+                        &core::mem::transmute_copy(&(a.0).0),
+                        &core::mem::transmute_copy(&(b.0).0),
+                        p,
+                        inv,
+                    );
+                    Some(core::mem::transmute_copy(&r))
+                }
+                4 => {
+                    let p8: &[u32; 8] = &*(p.as_ptr() as *const [u32; 8]);
+                    let r = cios8(
+                        &core::mem::transmute_copy(&(a.0).0),
+                        &core::mem::transmute_copy(&(b.0).0),
+                        p8,
+                        inv,
+                    );
+                    Some(core::mem::transmute_copy(&r))
+                }
+                _ => None,
+            }
+        }
+    }
