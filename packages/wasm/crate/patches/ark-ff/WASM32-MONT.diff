+    /// `r - p` if `top:r >= p` (r < 2p), else `r`, without branching on the value
+    #[inline(always)]
+    fn reduce_once<const L: usize>(r: &mut [u32; L], top: u32, p: &[u32; L]) {
+        let mut d = [0u32; L];
+        let mut borrow = 0u64;
+        for j in 0..L {
+            let x = (r[j] as u64).wrapping_sub(p[j] as u64).wrapping_sub(borrow);
+            d[j] = x as u32;
+            borrow = x >> 63;
+        }
+        // keep r - p unless the subtraction borrowed past the top limb
+        let below = borrow as u32 & (top == 0) as u32;
+        let keep = 0u32.wrapping_sub(below);
+        for j in 0..L {
+            r[j] = (r[j] & keep) | (d[j] & !keep);
+        }
+    }
