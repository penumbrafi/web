     /// zero bit in the rest of the modulus.
     #[inline]
     fn mul_assign(a: &mut Fp<Self, N>, b: &Fp<Self, N>) {
+        // here, not in MontConfig: #[derive(MontConfig)] overrides those defaults
+        #[cfg(target_arch = "wasm32")]
+        if let Some(r) = mont32::mul(a, b) {
+            (a.0).0 = r;
+            return;
+        }
         T::mul_assign(a, b)
     }
 
     fn sum_of_products<const M: usize>(a: &[Fp<Self, N>; M], b: &[Fp<Self, N>; M]) -> Fp<Self, N> {
+        #[cfg(target_arch = "wasm32")]
+        if N == 4 || N == 6 {
+            if M == 2 {
+                if let Some(r) = mont32::sum_of_two([&a[0], &a[1]], [&b[0], &b[1]]) {
+                    return Fp::new_unchecked(BigInt(r));
+                }
+            }
+            return a.iter().zip(b).map(|(a, b)| *a * b).sum();
+        }
         T::sum_of_products(a, b)
     }
 
