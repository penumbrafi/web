+    /// fixed-size CIOS so every loop unrolls and indexes are constant
+    macro_rules! cios {
+        ($name:ident, $l:literal) => {
+            #[inline(always)]
+            fn $name(a: &[u32; $l], b: &[u32; $l], p: &[u32; $l], inv: u32) -> [u32; $l] {
+                let mut t = [0u32; $l + 2];
+                for i in 0..$l {
+                    let bi = b[i] as u64;
+                    let mut carry = 0u64;
+                    for j in 0..$l {
+                        let s = t[j] as u64 + a[j] as u64 * bi + carry;
+                        t[j] = s as u32;
+                        carry = s >> 32;
+                    }
+                    let s = t[$l] as u64 + carry;
+                    t[$l] = s as u32;
+                    t[$l + 1] = (s >> 32) as u32;
+                    let m = t[0].wrapping_mul(inv) as u64;
+                    let mut carry = (t[0] as u64 + m * p[0] as u64) >> 32;
+                    for j in 1..$l {
+                        let s = t[j] as u64 + m * p[j] as u64 + carry;
+                        t[j - 1] = s as u32;
+                        carry = s >> 32;
+                    }
+                    let s = t[$l] as u64 + carry;
+                    t[$l - 1] = s as u32;
+                    t[$l] = t[$l + 1] + (s >> 32) as u32;
+                }
+                let mut r = [0u32; $l];
+                r.copy_from_slice(&t[..$l]);
+                reduce_once(&mut r, t[$l], p);
+                r
+            }
+        };
+    }
+    cios!(cios8, 8);
+    cios!(cios12, 12);
