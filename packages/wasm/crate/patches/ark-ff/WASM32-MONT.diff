+    /// double-width product, Montgomery reduction, and the operations built on
+    /// them: a square that computes each cross product once, and a sum of two
+    /// products that reduces once (a0*b0 + a1*b1 < 2p^2 < p*R).
+    macro_rules! sos {
+        ($wide:ident, $sqr:ident, $redc:ident, $l:literal) => {
+            #[inline(always)]
+            fn $wide(a: &[u32; $l], b: &[u32; $l], t: &mut [u32; 2 * $l + 1]) {
+                for i in 0..$l {
+                    let ai = a[i] as u64;
+                    let mut carry = 0u64;
+                    for j in 0..$l {
+                        let s = t[i + j] as u64 + ai * b[j] as u64 + carry;
+                        t[i + j] = s as u32;
+                        carry = s >> 32;
+                    }
+                    t[i + $l] = carry as u32;
+                }
+            }
+
+            #[inline(always)]
+            fn $sqr(a: &[u32; $l], t: &mut [u32; 2 * $l + 1]) {
+                // cross products once
+                for i in 0..$l {
+                    let ai = a[i] as u64;
+                    let mut carry = 0u64;
+                    for j in (i + 1)..$l {
+                        let s = t[i + j] as u64 + ai * a[j] as u64 + carry;
+                        t[i + j] = s as u32;
+                        carry = s >> 32;
+                    }
+                    t[i + $l] = carry as u32;
+                }
+                // double them
+                let mut top = 0u32;
+                for k in 0..2 * $l {
+                    let v = t[k];
+                    t[k] = (v << 1) | top;
+                    top = v >> 31;
+                }
+                // add the squares on the diagonal
+                let mut carry = 0u64;
+                for i in 0..$l {
+                    let sq = a[i] as u64 * a[i] as u64;
+                    let s = t[2 * i] as u64 + (sq & 0xffff_ffff) + carry;
+                    t[2 * i] = s as u32;
+                    let s = t[2 * i + 1] as u64 + (sq >> 32) + (s >> 32);
+                    t[2 * i + 1] = s as u32;
+                    carry = s >> 32;
+                }
+                t[2 * $l] = carry as u32;
+            }
+
+            /// `t * R^-1 mod p` for t < p*R
+            #[inline(always)]
+            fn $redc(t: &mut [u32; 2 * $l + 1], p: &[u32; $l], inv: u32) -> [u32; $l] {
+                // `extra` is the carry out of row i's top limb, added at row
+                // i + 1's top limb: every row does the same fixed work
+                let mut extra = 0u64;
+                for i in 0..$l {
+                    let m = t[i].wrapping_mul(inv) as u64;
+                    let mut carry = 0u64;
+                    for j in 0..$l {
+                        let s = t[i + j] as u64 + m * p[j] as u64 + carry;
+                        t[i + j] = s as u32;
+                        carry = s >> 32;
+                    }
+                    let s = t[i + $l] as u64 + carry + extra;
+                    t[i + $l] = s as u32;
+                    extra = s >> 32;
+                }
+                let mut r = [0u32; $l];
+                r.copy_from_slice(&t[$l..2 * $l]);
+                reduce_once(&mut r, t[2 * $l] + extra as u32, p);
+                r
+            }
+        };
+    }
+    sos!(wide8, sqr8, redc8, 8);
+    sos!(wide12, sqr12, redc12, 12);
+
+    /// add `b` into `a` (same width), returning nothing: callers keep headroom
+    #[inline(always)]
+    fn add_into<const W: usize>(a: &mut [u32; W], b: &[u32; W]) {
+        let mut carry = 0u64;
+        for k in 0..W {
+            let s = a[k] as u64 + b[k] as u64 + carry;
+            a[k] = s as u32;
+            carry = s >> 32;
+        }
+    }
